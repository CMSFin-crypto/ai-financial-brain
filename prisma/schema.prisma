generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portfolio {
  id        String   @id @default(cuid())
  sessionId String   @default("default")
  ticker    String
  company   String
  sector    String
  shares    Float
  avgPrice  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades    Trade[]
}

model Trade {
  id         String   @id @default(cuid())
  sessionId  String   @default("default")
  ticker     String
  company    String
  action     String
  shares     Float
  price      Float
  totalValue Float
  reason     String?
  createdAt  DateTime @default(now())

  portfolioId String?
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  sessionId   String   @default("default")
  ticker      String
  company     String
  sector      String
  note        String?
  createdAt   DateTime @default(now())

  alertAbove  Float?
  alertBelow  Float?
  alertActive Boolean  @default(true)
  alertedAt   DateTime?

  @@unique([sessionId, ticker])
}

// ═══════════════════════════════════════════════════════════════
// PREDICTION SYSTEM — Postgres-backed, factor-level tracking
// ═══════════════════════════════════════════════════════════════

model Prediction {
  id               String   @id @default(cuid())
  ticker           String
  sector           String   @default("UNKNOWN")
  source           String   @default("predict-api") // "predict-api" | "scan" | "scheduled"
  modelVersion     String   @default("2.0")

  // What was predicted
  signal           String   // "STRONG_BUY" | "BUY" | "NEUTRAL" | "SELL" | "STRONG_SELL"
  confidence       Int      // 0-100 calibrated
  combinedScore    Float    // -100 to +100
  technicalScore   Float
  fundamentalScore Float    @default(0)
  regimeScore      Float    @default(0)
  eventRiskScore   Float    @default(0)

  // Horizon-specific predictions (1D, 5D, 20D)
  horizonDays      Int      // 1, 5, or 20
  predictedDir     String   // "UP" | "DOWN" | "SIDEWAYS"
  predictedMovePct Float    // expected move in %
  entryPrice       Float

  // Evaluation fields — filled by evaluator
  dueAt            DateTime
  actualPrice      Float?
  evaluatedAt      DateTime?
  returnPct        Float?   // actual return %
  benchmarkReturnPct Float? // SPY return % over same period
  wasCorrect       Boolean?
  gateStatus       String   @default("TRADE") // "TRADE" | "NO_TRADE" + reason
  gateReason       String?

  // Regime Intelligence
  regimeState      String?  // "BULL_LOW_VOL" | "BEAR_HIGH_VOL" | "PANIC_CAPITULATION" | "RELIEF_RALLY" | "RANGE_NEUTRAL"
  regimeConfidence Float?  // 0-1
  regimePolicy     Json?   // full policy snapshot at prediction time

  // Brier calibration fields
  actualOutcome     Int?       // binary 0/1 for Brier score: 1 = predicted direction was correct
  transitionRisk    Float?     // regime transition probability at prediction time

  // Metadata
  noTradeReason    String?
  lessonExtracted  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  factors          PredictionFactor[]
  snapshot         MarketSnapshot?

  @@index([ticker, createdAt])
  @@index([dueAt, wasCorrect])
  @@index([horizonDays, wasCorrect])
  @@index([regimeState, wasCorrect])
  @@index([modelVersion, createdAt])
  @@index([regimeState, createdAt])
}

model PredictionFactor {
  id           String   @id @default(cuid())
  predictionId String
  factorName   String   // "rsi" | "macdHistogram" | "pe_ratio" | "revenue_growth" etc.
  factorType   String   // "technical" | "fundamental" | "regime" | "event"
  score        Float    // -100 to +100
  weight       Float    // weight used at prediction time
  contribution Float    // score * weight
  signal       String   @default("NEUTRAL") // "BULLISH" | "BEARISH" | "NEUTRAL"
  description  String   @default("")
  createdAt    DateTime @default(now())

  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([predictionId])
  @@index([factorName, factorType])
  @@index([factorType])
}

model ModelWeight {
  id          String   @id @default(cuid())
  factorName  String   // "rsi" | "macdHistogram" | "pe_ratio" etc.
  factorType  String   // "technical" | "fundamental" | "regime"
  weight      Float    // current weight (sum should = 1.0 per type)
  sampleSize  Int      @default(0) // how many predictions contributed
  accuracy    Float    @default(0) // observed accuracy % for this factor
  streakCorrect Int   @default(0)
  streakWrong   Int   @default(0)
  minSample   Int      @default(30) // minimum sample before weight changes
  updatedAt   DateTime @updatedAt

  @@unique([factorName])
}

model MarketSnapshot {
  id            String   @id @default(cuid())
  predictionId  String   @unique
  regime        String   @default("UNKNOWN") // "BULL" | "BEAR" | "VOLATILE" | "RANGING"
  regimeConfidence Float @default(0)
  spyPrice      Float?
  spyChange5d   Float?
  spyChange20d  Float?
  vixLevel      Float?
  marketBreadth  Float?   // % of stocks above 200-day MA
  sectorAvg     Float?   // average prediction score for this sector
  createdAt     DateTime @default(now())

  prediction    Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
}

model EventSnapshot {
  id            String   @id @default(cuid())
  ticker        String
  eventType     String   // "earnings" | "fed" | "geopolitical" | "sector_news" | "none"
  eventDate     DateTime?
  daysUntil     Int?
  severity      String   @default("LOW") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  description   String   @default("")
  createdAt     DateTime @default(now())

  @@index([ticker, eventType])
  @@index([eventDate])
}

// ═══════ GLOBAL SPILLOVER ENGINE ═══════

model GlobalMarketSnapshot {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  symbol      String   // "KOSPI" | "^N225" | "^HSI" | "SPY" | "QQQ" | "SMH" | "VIX" etc.
  assetType   String   @default("INDEX") // "INDEX" | "ETF" | "STOCK" | "VOLATILITY"
  region      String   // "ASIA_PACIFIC" | "US" | "EUROPE"
  sector      String?  // "SEMICONDUCTOR" | "INDEX" | "VOLATILITY"
  open        Float
  high        Float
  low         Float
  close       Float
  volume      Float    @default(0)
  return1d    Float    @default(0)
  return2d    Float?
  return5d    Float?
  atr14       Float?
  sma20       Float?
  sma50       Float?
  sma200      Float?
  createdAt   DateTime @default(now())

  @@index([symbol, date])
  @@index([region, date])
  @@index([sector, date])
  @@index([date])
}

model SpilloverSignal {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  targetSymbol   String   // e.g. "NVDA", "SMH", "SOXX"
  targetSector   String?  // e.g. "SEMICONDUCTOR"
  setupType      String   // "CONTINUATION" | "CAPITULATION" | "RELIEF_RALLY" | "NEUTRAL"
  spilloverScore Float    // -100 to +100
  confidence     Float    // 0 to 1
  modelVersion   String   @default("spillover-v1") // "spillover-v1" | "spillover-v2-logreg"
  reasons        Json     // string[] of human-readable reasons
  features       Json?    // full SpilloverFeatures snapshot
  createdAt      DateTime @default(now())

  @@index([targetSymbol, date])
  @@index([setupType, date])
  @@index([modelVersion, date])
  @@index([date])
}

model SpilloverModelResult {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  targetSymbol     String
  modelVersion     String   // "spillover-v2-logreg" | "spillover-v2-xgb"
  probabilityUp    Float    // 0 to 1
  probabilityDown  Float    // 0 to 1
  predictedClass    String   // "RELIEF_RALLY" | "CONTINUATION" | "NEUTRAL"
  actualClass      String?  // filled by evaluator
  actualReturn     Float?  // filled by evaluator
  wasCorrect       Boolean?
  createdAt        DateTime @default(now())

  @@index([targetSymbol, date])
  @@index([modelVersion, date])
  @@index([date])
}

// ═══════ REGIME INTELLIGENCE ═══════

model RegimeSnapshot {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  regimeState      String   // "BULL_LOW_VOL" | "BEAR_HIGH_VOL" | "PANIC_CAPITULATION" | "RELIEF_RALLY" | "RANGE_NEUTRAL"
  confidence       Float    // 0 to 1
  transitionRisk   Float    @default(0) // 0-1, probability of regime change within 5 days
  // Raw features at detection time
  spyReturn1d      Float?
  spyReturn5d      Float?
  spyReturn20d     Float?
  spyVsSma200      Float?  // % above/below SMA200
  vixLevel         Float?
  vixReturn1d      Float?
  atrZScore        Float?
  breadthPct       Float?  // % of stocks above SMA50
  adxLevel         Float?
  spilloverScore   Float?
  spilloverSetup   String?
  eventRiskScore   Float?
  // Policy snapshot
  policy           Json?    // full RegimePolicy at detection time
  drivers          Json?    // string[] of human-readable reasons
  createdAt        DateTime @default(now())

  @@unique([date]) // one regime snapshot per day
  @@index([regimeState, date])
  @@index([date])
}

// ═══════ MODEL METRICS (Brier calibration layer) ═══════

model ModelMetricSnapshot {
  id              String   @id @default(cuid())
  modelVersion    String
  horizonDays     Int
  sampleSize      Int
  accuracy        Float?
  avgReturn       Float?
  winRate         Float?
  brierScore      Float?
  precisionBuy    Float?
  recallBuy       Float?
  noTradeRate     Float?
  maxDrawdown     Float?
  createdAt       DateTime @default(now())

  @@index([modelVersion, createdAt])
  @@index([horizonDays, createdAt])
}

// ═══════ AI LEARNING SYSTEM ═══════

model AILesson {
  id          String   @id @default(cuid())
  category    String   // "overconfidence" | "wrong_direction" | "timing" | "sector_bias" | "volatility" | "macro_miss"
  ticker      String?
  sector      String?
  mistake     String
  lesson      String
  severity    Int      // 1-5
  timesApplied Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIStats {
  id              String   @id @default(cuid())
  totalPredictions Int     @default(0)
  correctPredictions Int   @default(0)
  avgAccuracy      Float   @default(0)
  bestSector       String?
  worstSector      String?
  streakCorrect    Int     @default(0)
  streakWrong      Int     @default(0)
  lessonsLearned   Int     @default(0)
  updatedAt        DateTime @updatedAt

  // Per-horizon accuracy
  accuracy1d       Float   @default(0)
  accuracy5d       Float   @default(0)
  accuracy20d      Float   @default(0)

  // Calibrated confidence tracking
  confidenceBuckets Json?   // {"50-60": {total:10, correct:6}, "60-70": {...}}
}
